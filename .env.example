# ─── Liara Management API ─────────────────────────────────────────────────────
# Console → حساب کاربری → API. A TEAM token, not a personal one.
LIARA_API_TOKEN=
# REQUIRED for team accounts. Without it the API silently answers for the
# personal account (which is empty) instead of erroring. See VERIFIED-FACTS §1.
LIARA_TEAM_ID=
# The shared token above is a local-development convenience. Set this to true
# only for a private/local demo; public users should connect their own account
# through the encrypted httpOnly session cookie instead.
ALLOW_SHARED_LIARA_TOKEN=false

LIARA_API_BASE_PAAS=https://api.iran.liara.ir
LIARA_API_BASE_DBAAS=https://api.iran.liara.ir
LIARA_API_BASE_DNS=https://dns-service.iran.liara.ir
LIARA_API_BASE_STORAGE=https://storage-service.iran.liara.ir

# ─── Liara AI ─────────────────────────────────────────────────────────────────
# Console → هوش مصنوعی → workspace → «اتصال». The workspace id is in the URL.
LIARA_AI_BASE_URL=https://ai.liara.ir/api/<workspace-id>/v1
LIARA_AI_KEY=

# Model routing. Flash both routes and answers; the reasoning model is only
# reached on a Level-3 escalation. BASELINE is never called — it exists so the
# footer can price the same conversation "as if" it had all run on the big model.
MODEL_ROUTER=google/gemini-3.7-flash
MODEL_ANSWER=google/gemini-3.7-flash
MODEL_REASON=anthropic/claude-sonnet-5
MODEL_BASELINE=anthropic/claude-opus-5
MODEL_EMBED=intfloat/multilingual-e5-large

# Optional OpenAI-compatible backup gateway. Leave both empty to keep all calls
# on Liara; the reasoning tier then falls back to the Liara answer model.
FAILOVER_AI_BASE_URL=
FAILOVER_AI_KEY=

# ─── Secrets ──────────────────────────────────────────────────────────────────
# openssl rand -base64 32
# Binds each tool approval to the server that issued it, so a crafted message
# history cannot forge a confirmation. Fail-closed: no secret, no approval.
TOOL_APPROVAL_SECRET=
# Encrypts the "connect your own Liara account" token in an httpOnly cookie.
# That token is never written to disk, never logged, and never leaves the cookie.
TOKEN_COOKIE_SECRET=

# ─── Retrieval ────────────────────────────────────────────────────────────────
# Keyword search is always on and free. Semantic search costs an embedding call
# per query, so it is off by default and escalated to only when keyword
# confidence is low. Requires: node scripts/build-docs-index.mjs
ENABLE_SEMANTIC_RAG=false
DOCS_SNAPSHOT_DIR=./data/docs
DOCS_VECTORS_PATH=./data/docs-vectors.json
